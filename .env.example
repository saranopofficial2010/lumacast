# YouTube stream key is available in YouTube Studio > Go live > Stream settings.
# The key stays on the server if RTMP_TARGET is configured here.
RTMP_TARGET=rtmps://a.rtmps.youtube.com/live2/REPLACE_WITH_STREAM_KEY
RTMP_ALLOWED_HOSTS=a.rtmps.youtube.com,b.rtmps.youtube.com,a.rtmp.youtube.com,b.rtmp.youtube.com
FFMPEG_PATH=ffmpeg
PORT=4173
